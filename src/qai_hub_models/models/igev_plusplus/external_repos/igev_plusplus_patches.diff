+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+import numpy as np
+
+
+def _conv3d_output_len(length, kernel, stride, pad, dilation):
+    return (length + 2 * pad - dilation * (kernel - 1) - 1) // stride + 1
+
+
+def _conv3d_via_2d_folded(x, weight, bias, stride, padding, dilation=(1, 1, 1)):
+    B, Cin, D, H, W = x.shape
+    kD, kH, kW = weight.shape[2], weight.shape[3], weight.shape[4]
+    sD, sH, sW = stride
+    pD, pH, pW = padding
+    dD, dH, dW = dilation
+    # Qualcomm Change: pre-unbind rank-5 weight into rank-4 slices before loop
+    # to avoid Gather on rank-5 weight tensor (rejected by QAIRT 2.50+ HTP).
+    weight_kd = weight.unbind(dim=2)  # tuple of kD rank-4 tensors (Cout,Cin,kH,kW)
+    if pD > 0:
+        x = F.pad(x, (0, 0, 0, 0, pD, pD))
+    Dout = _conv3d_output_len(D, kD, sD, pD, dD)
+    out2d = None
+    for kd in range(kD):
+        start = kd * dD
+        sl = x[:, :, start:start + (Dout - 1) * sD + 1:sD, :, :]
+        b, c, d, h, w = sl.shape
+        sl2d = sl.permute(0, 2, 1, 3, 4).reshape(b * d, c, h, w)
+        conv_out = F.conv2d(sl2d, weight_kd[kd], stride=(sH, sW), padding=(pH, pW), dilation=(dH, dW))
+        out2d = conv_out if out2d is None else out2d + conv_out
+    if bias is not None:
+        out2d = out2d + bias.view(1, -1, 1, 1)
+    return out2d, B, Dout
+
+
+def conv3d_via_2d(x, weight, bias, stride, padding, dilation=(1, 1, 1)):
+    out2d, B, Dout = _conv3d_via_2d_folded(x, weight, bias, stride, padding, dilation)
+    _, co, ho, wo = out2d.shape
+    return out2d.reshape(B, Dout, co, ho, wo).permute(0, 2, 1, 3, 4)
+
+
+def _dilate_d(x, stride):
+    if stride == 1:
+        return x
+    B, C, D, H, W = x.shape
+    zero = x.new_zeros(B, C, 1, H, W)
+    pieces = []
+    for d in range(D):
+        pieces.append(x.narrow(2, d, 1))
+        if d < D - 1:
+            pieces.extend([zero] * (stride - 1))
+    return torch.cat(pieces, dim=2)
+
+
+def _conv_transpose3d_via_2d_folded(x, weight, bias, stride, padding, dilation=(1, 1, 1)):
+    B, Cin, Din, H, W = x.shape
+    kD, kH, kW = weight.shape[2], weight.shape[3], weight.shape[4]
+    sD, sH, sW = stride
+    pD, pH, pW = padding
+    dD, dH, dW = dilation
+    # Qualcomm Change: pre-unbind rank-5 weight into rank-4 slices before loop
+    # to avoid Gather on rank-5 weight tensor (rejected by QAIRT 2.50+ HTP).
+    weight_kd = weight.unbind(dim=2)  # tuple of kD rank-4 tensors (Cin,Cout,kH,kW)
+    x_dil = _dilate_d(x, sD)
+    pad_eff = dD * (kD - 1) - pD
+    assert pad_eff >= 0
+    if pad_eff > 0:
+        x_dil = F.pad(x_dil, (0, 0, 0, 0, pad_eff, pad_eff))
+    Dout = (Din - 1) * sD - 2 * pD + dD * (kD - 1) + 1
+    out2d = None
+    for kd in range(kD):
+        kd_src = kD - 1 - kd
+        start = kd * dD
+        sl = x_dil[:, :, start:start + Dout, :, :]
+        b, c, d, h, w = sl.shape
+        sl2d = sl.permute(0, 2, 1, 3, 4).reshape(b * d, c, h, w)
+        conv_out = F.conv_transpose2d(sl2d, weight_kd[kd_src], stride=(sH, sW), padding=(pH, pW), dilation=(dH, dW))
+        out2d = conv_out if out2d is None else out2d + conv_out
+    if bias is not None:
+        out2d = out2d + bias.view(1, -1, 1, 1)
+    return out2d, B, Dout
+
+
+def _batch_norm_2d_affine(x, running_mean, running_var, weight, bias, eps=1e-5):
+    mean = running_mean.view(1, -1, 1, 1)
+    var = running_var.view(1, -1, 1, 1)
+    w = weight.view(1, -1, 1, 1)
+    b = bias.view(1, -1, 1, 1)
+    return (x - mean) / torch.sqrt(var + eps) * w + b
+
+
