# Converts bare module imports to relative imports for package structure
# compatibility. Also rewrites the YOLOLayer / JDELayer inference branches
# to avoid in-place slice assignments on a 5D tensor (io[..., :2] = ...).
# torch.export lowers those as scatter ops that blow up the compiled QNN
# graph. The rewrite builds the output with torch.cat. The activations stay
# on the 5D tensor: flattening it before the sigmoid breaks onnx / qnn_dlc
# accuracy on device (47.2 -> 0.02 mAP) even though CPU output is identical.
#
diff --git a/models/models.py b/models/models.py
index 76c44b6..244e6af 100644
--- a/models/models.py
+++ b/models/models.py
@@ -1,7 +1,7 @@
-from utils.google_utils import *
-from utils.layers import *
-from utils.parse_config import *
-from utils import torch_utils
+from ..utils.google_utils import *
+from ..utils.layers import *
+from ..utils.parse_config import *
+from ..utils import torch_utils

 ONNX_EXPORT = False

@@ -417,16 +417,11 @@ class YOLOLayer(nn.Module):
             return p_cls, xy * ng, wh

         else:  # inference
-            io = p.sigmoid()
-            io[..., :2] = (io[..., :2] * 2. - 0.5 + self.grid)
-            io[..., 2:4] = (io[..., 2:4] * 2) ** 2 * self.anchor_wh
-            io[..., :4] *= self.stride
-            #io = p.clone()  # inference output
-            #io[..., :2] = torch.sigmoid(io[..., :2]) + self.grid  # xy
-            #io[..., 2:4] = torch.exp(io[..., 2:4]) * self.anchor_wh  # wh yolo method
-            #io[..., :4] *= self.stride
-            #torch.sigmoid_(io[..., 4:])
-            return io.view(bs, -1, self.no), p  # view [1, 3, 13, 13, 85] as [1, 507, 85]
+            io = p.sigmoid()
+            xy = (io[..., 0:2] * 2. - 0.5 + self.grid) * self.stride
+            wh = (io[..., 2:4] * 2) ** 2 * self.anchor_wh * self.stride
+            io_out = torch.cat([xy, wh, io[..., 4:]], dim=-1)
+            return io_out.view(bs, -1, self.no), p


 class JDELayer(nn.Module):
@@ -510,16 +505,11 @@ class JDELayer(nn.Module):
             return p_cls, xy * ng, wh

         else:  # inference
-            #io = p.sigmoid()
-            #io[..., :2] = (io[..., :2] * 2. - 0.5 + self.grid)
-            #io[..., 2:4] = (io[..., 2:4] * 2) ** 2 * self.anchor_wh
-            #io[..., :4] *= self.stride
-            io = p.clone()  # inference output
-            io[..., :2] = torch.sigmoid(io[..., :2]) * 2. - 0.5 + self.grid  # xy
-            io[..., 2:4] = (torch.sigmoid(io[..., 2:4]) * 2) ** 2 * self.anchor_wh  # wh yolo method
-            io[..., :4] *= self.stride
-            io[..., 4:] = F.softmax(io[..., 4:])
-            return io.view(bs, -1, self.no), p  # view [1, 3, 13, 13, 85] as [1, 507, 85]
+            xy = (torch.sigmoid(p[..., 0:2]) * 2. - 0.5 + self.grid) * self.stride
+            wh = (torch.sigmoid(p[..., 2:4]) * 2) ** 2 * self.anchor_wh * self.stride
+            cls = F.softmax(p[..., 4:], dim=-1)
+            io_out = torch.cat([xy, wh, cls], dim=-1)
+            return io_out.view(bs, -1, self.no), p

 class Darknet(nn.Module):
